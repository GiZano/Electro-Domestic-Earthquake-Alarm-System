# --- APPLICATION SECRETS ---
# The base URL must include the protocol (https://) for the mobile app to resolve it properly.
# Use a Cloudflare quick tunnel URL (dev, ephemeral) or a real HTTPS domain (production).
# The URL must be reachable from the phone — never "localhost".
EXPO_PUBLIC_API_BASE_URL=https://your-tunnel-id.trycloudflare.com

# These must match the backend Application Secrets exactly
EXPO_PUBLIC_IOT_API_KEY=your_iot_api_key
EXPO_PUBLIC_MOBILE_WS_TOKEN=your_mobile_ws_token