# ==============================================================================
# QUAKEFINDER FIRMWARE CONFIGURATION (NGROK DEVELOPMENT)
# File: esp32_config.env
# Description: Environment variables injected into the firmware during build.
# Target Environment: Remote / ngrok Tunnel
# ==============================================================================

# --- Network Connectivity (WiFi) ---
# SSID and Password for the local access point.
WIFI_SSID="Mockup_Lab_WiFi_5G"
WIFI_PASS="LabNetworkPass123!"

# --- Backend Connection (HTTP via ngrok) ---
# Target Host Domain.
# NOTE: Do not include "http://" or "https://". Just the domain name provided by ngrok.
# Example: f4k3-123-45-67.ngrok-free.app
SERVER_HOST="your-tunnel-id.ngrok-free.app"

# Transport protocol. "https" for ngrok/WAN (default), "http" for LAN testing
# against a local backend (e.g. SERVER_HOST=192.168.1.10, SERVER_PORT=8000).
SERVER_PROTOCOL="https"

# Target Port. Defaults (80/443) are omitted from the URL.
SERVER_PORT=80

# API Endpoint Path.
SERVER_PATH="/readings/"

# --- Device Identity ---
# NOT configured here: the sensor ID is assigned automatically by the backend
# during the first-boot handshake (POST /devices/register) and persisted in the
# device's NVS. No manual per-sensor registration is required.

# --- HiveMQ Cloud MQTT Broker (Public) ---
# MQTT Broker Hostname (e.g., from HiveMQ Cloud Serverless)
MQTT_BROKER_HOST="your-cluster-id.s1.eu.hivemq.cloud"
MQTT_BROKER_PORT=8883
MQTT_USERNAME="your_mqtt_username"
MQTT_PASSWORD="your_mqtt_password"

# --- USB Serial Fallback (v1.2.2) ---
# When the MQTT/WiFi data plane is unreachable, the node re-certifies each
# seismic event and emits it over the USB CDC port as a machine-readable
# [QG:FB] frame. A co-located host runs firmware/tools/serial_bridge.py to
# read it and forward it to the ingestion pipeline.
# NOTE: frames are only emitted while a real USB host is attached (the node
# retains events in an in-memory ring when it is just powered). Set to 0 to
# disable the fallback and keep the MQTT-only behaviour.
SERIAL_FALLBACK_ENABLED=1
SERIAL_FALLBACK_MARKER="[QG:FB]"

# ==============================================================================
# SECURITY & CRYPTOGRAPHY NOTE
# ==============================================================================
# Cryptographic keys (Private/Public ECDSA pairs) are NOT configured in this file.
# Keys are automatically generated by the firmware upon first initialization
# and stored securely in the device's NVS (Non-Volatile Storage) partition.
#
# Check the Serial Monitor output on boot to retrieve the Public Key.
ENROLLMENT_TOKEN=your_enrollment_token

# ==============================================================================
# OPTIONAL GNSS (v1.3 readiness)
# ==============================================================================
# Uncomment to compile the GNSS sub-system (GnssModule.h/.cpp): real coordinates
# are reported at registration and the last-known fix is persisted in NVS as a
# fallback for cold boots before the first satellite fix. Leave commented to
# keep the default hermetic build (hardcoded fallback coordinates).
#
# GNSS_ENABLED=1
# GPS_SERIAL_RX_PIN=0
# GPS_SERIAL_TX_PIN=1
# GPS_SERIAL_BAUD=9600